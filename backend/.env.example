# PostgreSQL — ajuste para seu ambiente local ou serviço gerenciado
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zeladoria_sjp?schema=public"

# Porta em que a API sobe
PORT=3333

# Segredo usado para assinar os tokens JWT — troque em produção
JWT_SECRET="troque-este-valor-em-producao"
JWT_EXPIRES_IN="7d"

# Pasta local para uploads de fotos (MVP). Em produção, trocar por S3/Supabase Storage.
UPLOAD_DIR="uploads"
